        <mxCell id="title" value="Deployment Diagram — ai-asst-km Python Runtime" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans TC;fontSize=28;fontStyle=1;fontColor=#2D2438;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="1460" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Production：Cloud Run 如何把請求交給 Gunicorn process、worker 與 Flask WSGI application" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Noto Sans TC;fontSize=15;fontColor=#6B6275;" vertex="1" parent="1"><mxGeometry x="72" y="88" width="1300" height="35" as="geometry"/></mxCell>

        <mxCell id="person-client" value="&lt;b&gt;[Person] API 呼叫者&lt;/b&gt;&lt;br&gt;Frontend 或另一支 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0F8;strokeColor=#5E35B1;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=16;fontColor=#2D2438;spacing=14;" vertex="1" parent="1"><mxGeometry x="45" y="405" width="205" height="135" as="geometry"/></mxCell>

        <mxCell id="cloud-run-node" value="[Deployment Node] Google Cloud Run — Production" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=#FAF8FC;fillOpacity=35;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=17;fontStyle=1;fontColor=#512DA8;verticalAlign=top;align=left;spacingTop=16;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="300" y="145" width="1240" height="750" as="geometry"/></mxCell>
        <mxCell id="cloud-run-ingress" value="&lt;b&gt;[Infrastructure Node]&lt;br&gt;Cloud Run Ingress&lt;/b&gt;&lt;br&gt;依 Service 設定把 HTTPS 請求送入 Instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=15;fontColor=#333333;spacing=13;" vertex="1" parent="1"><mxGeometry x="340" y="405" width="220" height="155" as="geometry"/></mxCell>

        <mxCell id="model-instance-node" value="[Deployment Node] Model API — Cloud Run Instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FB;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=16;fontStyle=1;fontColor=#512DA8;verticalAlign=top;align=left;spacingTop=14;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="610" y="185" width="860" height="285" as="geometry"/></mxCell>
        <mxCell id="model-master" value="&lt;b&gt;[Process] Gunicorn Master&lt;/b&gt;&lt;br&gt;監督 worker process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=15;fontColor=#2D2438;spacing=12;" vertex="1" parent="1"><mxGeometry x="655" y="285" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="model-workers" value="&lt;b&gt;[Worker Processes] 4 × gthread&lt;/b&gt;&lt;br&gt;每個 worker 25 threads&lt;br&gt;最多 100 個 thread 工作槽*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#512DA8;strokeWidth=3;fontFamily=Noto Sans TC;fontSize=15;fontColor=#2D2438;spacing=12;" vertex="1" parent="1"><mxGeometry x="925" y="270" width="235" height="150" as="geometry"/></mxCell>
        <mxCell id="model-flask" value="&lt;b&gt;[WSGI Application] Model API&lt;/b&gt;&lt;br&gt;[Flask + Flask-RESTX]&lt;br&gt;bootstrap_cloud:app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=15;fontColor=#2D2438;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="270" width="210" height="150" as="geometry"/></mxCell>

        <mxCell id="data-instance-node" value="[Deployment Node] Data API — Cloud Run Instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FB;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=16;fontStyle=1;fontColor=#512DA8;verticalAlign=top;align=left;spacingTop=14;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="610" y="535" width="860" height="285" as="geometry"/></mxCell>
        <mxCell id="data-master" value="&lt;b&gt;[Process] Gunicorn Master&lt;/b&gt;&lt;br&gt;監督 worker process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=15;fontColor=#2D2438;spacing=12;" vertex="1" parent="1"><mxGeometry x="655" y="635" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="data-worker" value="&lt;b&gt;[Worker Process] 1 × sync&lt;/b&gt;&lt;br&gt;一次主動處理 1 個 Request&lt;br&gt;未設定額外 threads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#512DA8;strokeWidth=3;fontFamily=Noto Sans TC;fontSize=15;fontColor=#2D2438;spacing=12;" vertex="1" parent="1"><mxGeometry x="925" y="620" width="235" height="150" as="geometry"/></mxCell>
        <mxCell id="data-flask" value="&lt;b&gt;[WSGI Application] Data API&lt;/b&gt;&lt;br&gt;[Flask + PyMongo]&lt;br&gt;app:app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=15;fontColor=#2D2438;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="210" height="150" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;圖例 (Legend)&lt;/b&gt;&lt;br&gt;虛線外框：Cloud Run deployment node&lt;br&gt;紫色外框：Service 的單一 Instance&lt;br&gt;深紫：主要 worker 設定&lt;br&gt;* 工作槽不等於同量 CPU 平行運算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;dashed=1;fontFamily=Noto Sans TC;fontSize=13;fontColor=#424242;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="700" width="245" height="170" as="geometry"/></mxCell>
        <mxCell id="evidence-note" value="&lt;b&gt;現行設定（2026-08-23）&lt;/b&gt;&lt;br&gt;Model：Cloud Run concurrency 100；Gunicorn timeout 600 秒&lt;br&gt;Data：Cloud Run concurrency 80；Gunicorn timeout 60 秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;dashed=1;fontFamily=Noto Sans TC;fontSize=13;fontColor=#424242;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="610" y="845" width="860" height="105" as="geometry"/></mxCell>

