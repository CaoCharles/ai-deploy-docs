<mxfile host="app.diagrams.net" modified="2026-08-24T09:10:00.000Z" version="31.1.8" type="device" compressed="false">
  <diagram id="api-request-runtime" name="API Request Runtime">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Runtime Dynamic Diagram — API Request 的執行路徑" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Noto Sans TC;fontSize=28;fontStyle=1;fontColor=#2D2438;" vertex="1" parent="1">
          <mxGeometry x="60" y="35" width="1680" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="一次 HTTP Request 如何穿過雲端入口、Server、介面規格與 Framework，再將 Response 回傳給 Client" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=Noto Sans TC;fontSize=15;fontColor=#5F566B;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1680" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;[External Client]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Browser／其他服務&lt;/font&gt;&lt;br&gt;&lt;br&gt;送出 HTTP Request&lt;br&gt;接收 HTTP Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="250" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="cloud-run-ingress" value="&lt;b&gt;[Deployment Node]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Cloud Run Ingress&lt;/font&gt;&lt;br&gt;&lt;br&gt;接收外部 HTTPS 流量&lt;br&gt;轉送至 Container Instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FB;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="385" y="220" width="270" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="application-server" value="&lt;b&gt;[Application Server]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Gunicorn／Uvicorn&lt;/font&gt;&lt;br&gt;&lt;br&gt;監聽 Container 的 PORT&lt;br&gt;管理 worker 或 event loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#512DA8;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="220" width="280" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="application-interface" value="&lt;b&gt;[Application Interface]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;WSGI／ASGI&lt;/font&gt;&lt;br&gt;&lt;br&gt;定義 Server 呼叫 Python&lt;br&gt;application 的介面規格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1085" y="220" width="280" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="web-framework" value="&lt;b&gt;[Web Framework]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Flask／FastAPI&lt;/font&gt;&lt;br&gt;&lt;br&gt;比對 Route、驗證資料&lt;br&gt;執行業務邏輯並建立 Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="220" width="290" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="request-1" value="1. 送出 Request [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5E35B1;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="cloud-run-ingress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="request-2" value="2. 轉送至 Container [HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5E35B1;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cloud-run-ingress" target="application-server">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="request-3" value="3. 呼叫 application" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5E35B1;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="application-server" target="application-interface">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="request-4" value="4. 進入 Route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5E35B1;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="application-interface" target="web-framework">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="response-5" value="5. 逐層回傳 HTTP Response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#616161;strokeWidth=2;fontFamily=Noto Sans TC;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="web-framework" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1585" y="520"/>
              <mxPoint x="185" y="520"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;圖例（Legend）&lt;/b&gt;&lt;br&gt;實線紫色：Request 前進方向&lt;br&gt;虛線灰色：Response 回傳方向&lt;br&gt;淡紫色：Container 內的 Runtime 層次&lt;br&gt;灰色：外部 Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;dashed=1;fontFamily=Noto Sans TC;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="625" width="390" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="reading-note" value="&lt;b&gt;閱讀重點&lt;/b&gt;&lt;br&gt;• Gunicorn／Uvicorn 是實際監聽 Port 的 Server。&lt;br&gt;• WSGI／ASGI 是 Server 與 Python application 之間的介面規格，不是獨立服務。&lt;br&gt;• Flask／FastAPI 負責 Route、資料驗證與業務邏輯。&lt;br&gt;• 本圖只描述 Runtime，不包含 Image build、部署與 Revision 建立。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;fontFamily=Noto Sans TC;fontSize=14;align=left;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="605" width="1200" height="205" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
